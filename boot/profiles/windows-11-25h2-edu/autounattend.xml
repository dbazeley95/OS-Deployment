<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows 11 25H2 Education unattend.xml. Shares boot media (kernel/initrd/WIM)
  with the Pro profile - only this file's WIM image index and this file
  itself differ. See boot/profiles/windows-11-25h2/README.md for the full
  setup walkthrough, including how to find your WIM's real image indices
  (they are NOT guaranteed to be 1/2 - check with
  `dism /Get-WimInfo /WimFile:install.wim`).

  This is a starting point, not a complete answer file - fill in whatever
  else your environment needs (product key, partitioning) following
  Microsoft's Unattend reference:
  https://learn.microsoft.com/windows-hardware/customize/desktop/unattend/
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend">
  <settings pass="windowsPE">
    <component name="Microsoft-Windows-International-Core-WinPE" processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <SetupUILanguage>
        <UILanguage>en-US</UILanguage>
      </SetupUILanguage>
      <UILanguage>en-US</UILanguage>
    </component>
    <component name="Microsoft-Windows-Setup" processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <ImageInstall>
        <OSImage>
          <InstallFrom>
            <MetaData wcm:action="add" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
              <!-- ADJUST-ME: verify with `dism /Get-WimInfo /WimFile:install.wim` -->
              <Key>/IMAGE/INDEX</Key>
              <Value>2</Value>
            </MetaData>
          </InstallFrom>
        </OSImage>
      </ImageInstall>
    </component>
  </settings>

  <settings pass="specialize">
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <!-- WIN-REIMAGED is a placeholder DeployGui.ps1 always replaces with
           the technician-entered hostname before writing this file to disk
           (see ../../winpe/README.md) - kept a valid computer name in case
           this file is ever used unmodified. -->
      <ComputerName>WIN-REIMAGED</ComputerName>
    </component>
  </settings>

  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <FirstLogonCommands>
        <!-- Deliberately does NOT run PostAction.ps1 directly, and deliberately
             does NOT download it here either - Microsoft's own docs say
             FirstLogonCommands entries "are all started at the same time, and
             no longer wait for the previous command to finish" on current
             Windows despite the Order element below, and this is also the
             least reliable moment in the whole boot for a network call (DNS/
             DHCP/the NIC itself may still be settling this early in first
             logon). A failed Invoke-WebRequest here used to abort this entire
             command, meaning the RunOnce entry below never got registered at
             all and nothing post-imaging ever ran - silently, with no error
             anywhere. This entry now does only local disk operations (seed
             files, write two registry values) and defers the actual download
             to RunOnce time instead, when the desktop is already up and
             networking is reliably available. RunOnce fires once, right as
             the first interactive desktop session starts, which is also what
             lets PostAction.ps1 show a real GUI instead of running invisibly
             before the desktop even appears. The "!" prefix on the value name
             defers its deletion until after the command exits, so if
             PostAction.ps1's own domain-join reboot kills the process partway
             through, Windows re-runs it at the next logon instead of losing
             the rest of the work - see boot/winpe/PostAction.ps1 for the
             resume logic. -->
        <SynchronousCommand>
          <Order>1</Order>
          <CommandLine>powershell -NoProfile -Command "New-Item -ItemType Directory -Force -Path C:\Windows\Setup\Scripts | Out-Null; if (-not (Test-Path 'C:\Windows\Setup\Scripts\post-action.json')) { '{\"domainJoin\":false,\"steps\":[]}' | Set-Content 'C:\Windows\Setup\Scripts\post-action.json' }; 'Invoke-WebRequest -Uri ''https://api.osd.xcet.uk/images/winpe/PostAction.ps1'' -OutFile ''C:\Windows\Setup\Scripts\PostAction.ps1''; &amp; ''C:\Windows\Setup\Scripts\PostAction.ps1''' | Set-Content 'C:\Windows\Setup\Scripts\RunPostAction.ps1'; New-ItemProperty -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\RunOnce' -Name '!PostAction' -Value 'powershell -NoProfile -ExecutionPolicy Bypass -File C:\Windows\Setup\Scripts\RunPostAction.ps1' -PropertyType String -Force | Out-Null"</CommandLine>
          <Description>Seed defaults, write a small bootstrap script that fetches and runs PostAction.ps1, then queue it via RunOnce once the desktop is reached</Description>
        </SynchronousCommand>
      </FirstLogonCommands>
    </component>
  </settings>
</unattend>
