# Example proxyDHCP config for netbooting into iPXE, without replacing your
# existing DHCP server. Run this on a small box (Raspberry Pi, VM, container)
# on the same L2 segment as the machines you're reimaging.
#
# proxyDHCP only answers PXE-specific DHCP options; it does NOT hand out IP
# leases, so it's safe to run alongside your normal router/DHCP server.

interface=eth0
port=0                     # disable dnsmasq's own DNS server
log-dhcp

# Act as a proxyDHCP server (piggybacks on the real DHCP server's lease).
dhcp-range=192.168.1.0,proxy

# Serve the iPXE chainload binary over TFTP for both legacy BIOS and UEFI.
enable-tftp
tftp-root=/srv/tftp

dhcp-match=set:efi-x86_64,option:client-arch,7
dhcp-match=set:efi-x86_64,option:client-arch,9
dhcp-boot=tag:efi-x86_64,ipxe.efi
dhcp-boot=tag:!efi-x86_64,undionly.kpxe

# Once the machine is running iPXE itself (not the initial PXE ROM), chain
# straight to the Worker so DHCP/TFTP drop out of the loop entirely.
dhcp-userclass=set:ipxe,iPXE
dhcp-boot=tag:ipxe,"https://os-deployment-worker.<your-subdomain>.workers.dev/boot/${net0/mac}"
